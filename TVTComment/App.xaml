<Application x:Class="TVTComment.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TVTComment"
             xmlns:options="clr-namespace:TVTComment.Views.ChatCollectServiceCreationOptionControl"
             xmlns:optionViewModels="clr-namespace:TVTComment.ViewModels.ChatCollectServiceCreationOptionControl"
             Startup="Application_Startup">
    <Application.Resources>
        <DataTemplate DataType="{x:Type optionViewModels:FileChatCollectServiceCreationOptionControlViewModel}">
            <options:FileChatCollectServiceCreationOptionControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type optionViewModels:NichanChatCollectServiceCreationOptionControlViewModel}">
            <options:NichanChatCollectServiceCreationOptionControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type optionViewModels:NiconicoLiveChatCollectServiceCreationOptionControlViewModel}">
            <options:NiconicoLiveChatCollectServiceCreationOptionControl/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type optionViewModels:TwitterLiveChatCollectServiceCreationOptionControlViewModel}">
            <options:TwitterLiveChatCollectServiceCreationOptionControl/>
        </DataTemplate>
    </Application.Resources>
</Application>
